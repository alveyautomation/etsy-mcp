# Etsy Open API v3 base URL. The default points at the public production host
# and is correct for almost all sellers — leave it alone unless Etsy has issued
# you a non-default URL.
ETSY_API_URL=https://api.etsy.com/v3/application/

# Etsy app keystring (the "x-api-key" credential from
# https://www.etsy.com/developers/your-apps). Required for every request.
ETSY_API_KEY=replace-me

# OAuth 2.0 refresh token issued to your app for the connected shop.
# Etsy uses OAuth 2.0 with PKCE; complete the auth-code flow once via your
# preferred flow runner and paste the resulting refresh token here. The
# server exchanges it for short-lived access tokens transparently.
ETSY_REFRESH_TOKEN=replace-me

# Optional: default ShopID to use when a tool call omits it.
# Leave blank to require an explicit `shop_id` on every call.
ETSY_DEFAULT_SHOP_ID=

# Optional: HTTP request timeout in seconds. Default 60.
ETSY_HTTP_TIMEOUT=60

# Optional: number of retry attempts on transient errors (5xx, 429, timeout).
# Default 3.
ETSY_MAX_RETRIES=3
